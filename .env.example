# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: Frontend / public URL
APP_URL="http://localhost:3000"

# Auth (Workers): min 16 characters. Required when ENVIRONMENT=production
AUTH_SECRET="change-me-to-a-long-random-string"
# Comma-separated browser origins allowed to call the API
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
ENVIRONMENT=""

# Steadfast webhook shared secret (send as X-Webhook-Secret header)
STEADFAST_WEBHOOK_SECRET=""

# OPENROUTER: Optional for order text extraction via OpenRouter models.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ----------------------------------------------------
# COURIER CONFIGURATIONS (Stored securely server-side)
# ----------------------------------------------------

# 1. STEADFAST COURIER API
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""
STEADFAST_BASE_URL="https://portal.steadfast.com.bd/api/v1"

# 2. PATHAO COURIER API (Official OAuth)
PATHAO_BASE_URL="https://api-hermes.pathao.com"
PATHAO_CLIENT_ID=""
PATHAO_CLIENT_SECRET=""
PATHAO_USERNAME=""
PATHAO_PASSWORD=""

# 3. REDX COURIER API
REDX_BASE_URL="https://openapi.redx.com.bd/v1.0.0-beta"
REDX_API_TOKEN=""

# 4. CARRYBEE COURIER API
CARRYBEE_BASE_URL="https://api.carrybee.com"
CARRYBEE_API_KEY=""
CARRYBEE_SECRET_KEY=""
